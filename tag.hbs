{{!< default}}

{{#tag}}
<section class="rg-wrap rg-hero rg-hero--small" aria-labelledby="rg-hero-title">
    <p class="rg-crumbs"><a href="{{@site.url}}">§ {{@site.title}}</a> <span aria-hidden="true">/</span> {{t "Topic"}}</p>
    <h1 class="rg-hero__title rg-hero__title--md" id="rg-hero-title">{{name}}<sup class="rg-hero__count">({{../pagination.total}})</sup></h1>
    {{#if description}}
        <div class="rg-hero__aside"><p class="rg-hero__desc">{{description}}</p></div>
    {{/if}}
</section>
{{/tag}}

<section class="rg-wrap rg-listing" aria-labelledby="rg-listing-title">
    <aside class="rg-side" aria-label="{{t "Browse"}}">
        {{> "rubriques" current=tag.slug}}
        {{> "archives-link"}}
    </aside>
    <div class="rg-listing__main">
        <div class="rg-listing__head">
            <h2 class="rg-listing__title" id="rg-listing-title">{{t "Letters in this topic"}}</h2>
        </div>
        {{> "letter-index"}}
        <ol class="rg-index">
            {{#foreach posts}}
                {{> "letter-row"}}
            {{/foreach}}
        </ol>
        {{pagination}}
    </div>
</section>
