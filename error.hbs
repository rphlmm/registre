{{!< default}}

<section class="rg-wrap rg-hero rg-error" aria-labelledby="rg-hero-title">
    <div class="rg-hero__main">
        <p class="rg-crumbs"><span class="rg-label rg-label--accent">§ {{t "Error"}} {{statusCode}}</span></p>
        <h1 class="rg-hero__title rg-hero__title--md" id="rg-hero-title">{{#match statusCode 404}}{{t "Page not found"}}{{else}}{{message}}{{/match}}</h1>
    </div>
    <div class="rg-hero__aside">
        <p class="rg-hero__desc">{{#match statusCode 404}}{{t "This address does not match any letter. Try the index or the search."}}{{else}}{{t "Something went wrong. Please try again in a moment."}}{{/match}}</p>
        <p class="rg-error__actions">
            <a class="rg-btn" href="{{@site.url}}">{{t "Back to the index"}}</a>
            <button class="rg-btn rg-btn--ghost" type="button" data-ghost-search>{{t "Search"}}</button>
        </p>
    </div>
</section>

{{#if errorDetails}}
    <section class="rg-wrap rg-error__details">
        <ul>
            {{#foreach errorDetails}}
                <li>
                    <p><strong>{{{rule}}}</strong></p>
                    {{#foreach failures}}
                        <p><strong>{{t "Ref:"}}</strong> {{ref}}<br><strong>{{t "Message:"}}</strong> {{message}}</p>
                    {{/foreach}}
                </li>
            {{/foreach}}
        </ul>
    </section>
{{/if}}
